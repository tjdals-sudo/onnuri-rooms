# .env.local 로 복사해서 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)

# ---- Supabase (대시보드 > Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 서버 전용 (브라우저 노출 금지)
SUPABASE_SECRET_KEY=sb_secret_...

# ---- 관리자 계정 초기 비밀번호 (scripts/create-admins.ts 실행 시 1회 사용) ----
ADMIN_ID_DOMAIN=onnuri-incheon.local
ADMIN1_PASSWORD=
ADMIN2_PASSWORD=
ADMIN3_PASSWORD=

# ---- Google Sheets (비워 두면 시트 연동을 건너뜀) ----
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# ---- Vercel Cron 보호 토큰 (아무 긴 문자열) ----
CRON_SECRET=

# ---- 통합 테스트 (npm run test:db) ----
TEST_ADMIN_LOGIN_ID=admin1
TEST_ADMIN_PASSWORD=
